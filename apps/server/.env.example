# Copy to .env and adjust. Every setting is optional for local development.

# Postgres connection string. Leave unset to use the embedded PGlite database in DATA_DIR.
# DATABASE_URL=postgres://empire:empire@localhost:5432/empire
# DATA_DIR=.data/pglite

# PORT=4000

# Public origin of the web app. Required in production (used in emailed links and OAuth redirects).
# PUBLIC_URL=https://empire.example.com

# When this server has its own subdomain (api.empire.example.com), the session cookie's domain,
# so the WebSocket there is signed in too.
# COOKIE_DOMAIN=empire.example.com

# SMTP for sign-in and war emails, e.g. smtps://user:pass@smtp.example.com:465
# Without it, emails are printed to this server's console.
# SMTP_URL=
# MAIL_FROM=Empire Chess <no-reply@example.com>

# Password-free sign-in by name. On by default outside production; never enable it publicly.
# DEV_LOGIN=1

# Lichess OAuth needs no registration; the client id is just a name Lichess shows to players.
# LICHESS_CLIENT_ID=empire-chess

# Web push for war notifications. Generate keys with `npx web-push generate-vapid-keys`; the
# subject is a contact URL for push services. Without keys, notifications go by email only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
