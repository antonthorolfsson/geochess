  "private": true,
  "description": "Authoritative game server: HTTP API, WebSockets, rules enforcement.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
