{
  "name": "@empire/web",
  "version": "0.0.0",
  "private": true,
  "description": "Installable web client: map room, lobbies, draft.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-datasets.mjs",
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "prebuild": "node scripts/copy-datasets.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "titles": "node scripts/make-titles.mjs"
  },
  "dependencies": {
    "@empire/rules": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "chessground": "^9.2.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@empire/data": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
