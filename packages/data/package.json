{
  "name": "@empire/data",
  "version": "0.0.0",
  "private": true,
  "description": "Map and country data pipeline. Builds the versioned datasets the game runs on.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./datasets/*": "./datasets/*",
    "./openings/*": "./openings/*",
    "./facts/*": "./facts/*"
  },
  "scripts": {
    "generate": "tsx scripts/build.ts",
    "openings": "tsx scripts/openings.ts",
    "preview": "tsx scripts/preview.ts",
    "facts": "tsx scripts/facts.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@empire/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/polylabel": "^2.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "polylabel": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  }
}
