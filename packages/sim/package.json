    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@empire/data": "workspace:*",
    "@empire/rules": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
